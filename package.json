{
  "name": "make-it-so",
  "version": "0.1.0",
  "description": "A multi-agent harness: command AI agents (Claude Code, kiro-cli) as a crew from a browser chat screen.",
  "license": "MIT",
  "author": "eka-s <32577635+eka-s@users.noreply.github.com>",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eka-s/make-it-so.git"
  },
  "bugs": {
    "url": "https://github.com/eka-s/make-it-so/issues"
  },
  "homepage": "https://github.com/eka-s/make-it-so#readme",
  "engines": {
    "node": ">=22.13"
  },
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently -P -n server,client -c blue,green \"tsx watch src/server/cli.ts {@}\" \"vite --config vite.config.ts -- {@}\" --",
    "dev:server": "tsx watch src/server/cli.ts",
    "dev:client": "vite --config vite.config.ts",
    "init": "tsx src/server/init-cli.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && vite build",
    "start": "node dist/server/cli.js",
    "start:electron": "electron dist/electron/main.js",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.client.json"
  },
  "dependencies": {
    "@a2ui/web_core": "0.15.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "4.22.3",
    "yaml": "2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@a2ui/markdown-it": "0.2.2",
    "@a2ui/react": "0.15.0",
    "@eslint/js": "9.39.5",
    "@fontsource/antonio": "5.3.0",
    "@types/express": "5.0.1",
    "@types/node": "22.15.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "electron": "45.4.1",
    "electron-builder": "26.18.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.0.3",
    "remark-gfm": "4.0.0",
    "tsx": "4.19.4",
    "typescript": "5.7.3",
    "typescript-eslint": "8.72.2",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  },
  "build": {
    "appId": "io.github.eka-s.make-it-so",
    "productName": "Make-It-So",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "!dist/**/*.d.ts",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "overrides": {
    "@a2ui/markdown-it": {
      "@a2ui/web_core": "$@a2ui/web_core"
    },
    "dompurify": "3.4.18"
  }
}
